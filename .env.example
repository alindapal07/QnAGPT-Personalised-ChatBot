# Groq API credentials (required; no OpenAI key required)
GROQ_API_KEY=your_groq_api_key_here

# Optional application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Data, local file storage, and SQLite database
# QNAGPT_DATA_DIR=./data
# QNAGPT_STORAGE_DIR=./storage
# DATABASE_URL=sqlite:///./data/chatbot.db
# LANGGRAPH_CHECKPOINT_DB=./data/chatbot.db

# Vector Database (Qdrant - supports QDRANT_MODE=local or QDRANT_MODE=cloud)
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qna_documents

# Authentication & Session Security
# SESSION_SECRET_KEY=
# SESSION_TTL_HOURS=168
APP_BASE_URL=http://localhost:8501

# Optional OAuth2 Providers (Google & GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional MCP Registry & Directory API configuration
# MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
# GLAMA_API_URL=https://glama.ai/api/mcp/v1
# GLAMA_API_KEY=your_glama_api_key_here
# QNAGPT_REGISTRY_CACHE_TTL_SEC=300

# Optional Fernet master key (32-byte URL-safe base64 or passphrase) for encrypting stored MCP credentials
# If omitted, QnAGPT automatically creates a restricted local key file under data/.mcp_vault.key
# QNAGPT_CREDENTIAL_KEY=
# QNAGPT_OAUTH_REDIRECT_URI=http://localhost:8501/oauth/callback
