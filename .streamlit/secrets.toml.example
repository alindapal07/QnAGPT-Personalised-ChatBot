# =============================================================================
# QnAGPT Streamlit Community Cloud Secrets Template
# Path: .streamlit/secrets.toml.example
# Copy these keys into your Streamlit Cloud App Settings -> Secrets interface.
# Never commit the real .streamlit/secrets.toml file to git.
# =============================================================================

# Application Environment Mode ('development' or 'production')
APP_ENV = "production"

# Primary LLM API Key (Groq Cloud) - Required
GROQ_API_KEY = "your-groq-api-key-here"

# HMAC Session Signing Secret (Required in production, minimum 32 chars)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY = "your-64-char-hex-session-signing-secret-here"

# Qdrant Cloud Vector Store Configuration
# Recommended for durable cloud vector persistence across Streamlit Cloud restarts
QDRANT_MODE = "cloud"
QDRANT_URL = "https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your-qdrant-cloud-api-key-here"
QDRANT_COLLECTION = "qna_documents"

# Production Relational Database URL (PostgreSQL / MySQL)
# Required in multi-user production to persist users and approvals across cloud redeploys
# Example: postgresql://qnagpt_user:StrongPassword@db-host.provider.com:5432/qnagpt_db
DATABASE_URL = "sqlite:///chatbot.db"

# Google OpenID Connect / OAuth Configuration (Optional)
# Ensure Redirect URI in Google Cloud Console is: https://<your-app>.streamlit.app
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# GitHub OAuth Configuration (Optional)
# Ensure Authorization Callback URL is: https://<your-app>.streamlit.app
GITHUB_CLIENT_ID = ""
GITHUB_CLIENT_SECRET = ""

# External Directory / Registry Keys (Optional)
GLAMA_API_KEY = ""
